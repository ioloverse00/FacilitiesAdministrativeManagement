APP_ENV=local
APP_DEBUG=true
APP_ALLOWED_ORIGIN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ismers_fam
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_SESSION_LIFETIME=7200
AUTH_COOKIE_SECURE=false
LOGIN_OTP_TTL_SECONDS=300
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=30
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_MFA_PENDING_TTL_SECONDS=600
SLA_DUE_SOON_MINUTES=480
DOCUMENT_OTP_TTL_SECONDS=60
DOCUMENT_OTP_RESEND_COOLDOWN_SECONDS=30
DOCUMENT_OTP_MAX_ATTEMPTS=5
DOCUMENT_STEP_UP_TTL_SECONDS=600

MAIL_ENABLED=false
MAIL_MODE=smtp
MAIL_ENVIRONMENT=sandbox
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=no-reply@example.local
SMTP_FROM_NAME="FAM Security"

GEMINI_API_KEY=
GEMINI_VISITOR_ID_MODEL=gemini-3.6-flash
GEMINI_VISITOR_ID_TIMEOUT_SECONDS=30
GEMINI_CONTRACT_METADATA_MODEL=
GEMINI_CONTRACT_METADATA_TIMEOUT_SECONDS=35
GEMINI_RESERVATION_SUMMARY_MODEL=
GEMINI_RESERVATION_SUMMARY_TIMEOUT_SECONDS=45
GEMINI_RETENTION_MODEL=
GEMINI_RETENTION_TIMEOUT_SECONDS=30
GEMINI_LEGAL_SUMMARY_MODEL=
GEMINI_LEGAL_SUMMARY_TIMEOUT_SECONDS=60
GEMINI_LEGAL_PARTY_TIMEOUT_SECONDS=60
GEMINI_LEGAL_ANALYSIS_MODEL=
GEMINI_LEGAL_ANALYSIS_TIMEOUT_SECONDS=60
GEMINI_LEGAL_ACTION_MODEL=
GEMINI_LEGAL_ACTION_TIMEOUT_SECONDS=60
VISITOR_ID_DIAGNOSTICS=false

# Local Google Docs contract authoring integration.
# Keep real values only in .env; never commit client secrets or encryption keys.
GOOGLE_DOCS_INTEGRATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/FacilitiesAdministrativeManagement/api/integrations/google/callback.php
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DOCS_ALLOWED_CONFIDENTIALITY=PUBLIC,INTERNAL
