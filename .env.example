APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ismers_fam
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_SESSION_LIFETIME=7200
APP_ALLOWED_ORIGIN=
SLA_DUE_SOON_MINUTES=480

MAIL_MODE=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.local
MAIL_FROM_NAME="FAM Visitor Registration"

GEMINI_API_KEY=
GEMINI_VISITOR_ID_MODEL=gemini-3.6-flash
GEMINI_VISITOR_ID_TIMEOUT_SECONDS=30
VISITOR_ID_DIAGNOSTICS=false
