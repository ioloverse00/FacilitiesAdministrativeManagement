RewriteEngine On

# Legacy page URLs remain compatible while pointing users to canonical routes.
# THE_REQUEST limits redirects to original client requests, not internal rewrites.
RewriteCond %{THE_REQUEST} \s/+pages/dashboard\.html[\s?] [NC]
RewriteRule ^pages/dashboard\.html$ /dashboard [R=302,L]
RewriteCond %{THE_REQUEST} \s/+pages/room-reservations\.html[\s?] [NC]
RewriteRule ^pages/room-reservations\.html$ /facilities-reservation [R=302,L]
RewriteCond %{THE_REQUEST} \s/+pages/visitor-management\.html[\s?] [NC]
RewriteRule ^pages/visitor-management\.html$ /visitor-management [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?pages/visitor-scanner\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)pages/visitor-scanner\.html$ [NC]
RewriteRule ^pages/visitor-scanner\.html$ %1visitor-scanner/ [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?visitor-scanner\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)visitor-scanner\.html$ [NC]
RewriteRule ^visitor-scanner\.html$ %1visitor-scanner/ [R=302,L]
RewriteCond %{THE_REQUEST} \s/+pages/contract-management\.html[\s?] [NC]
RewriteRule ^pages/contract-management\.html$ /contract-management [R=302,L]
RewriteCond %{THE_REQUEST} \s/+pages/legal-management\.html[\s?] [NC]
RewriteRule ^pages/legal-management\.html$ /legal-management [R=302,L]
RewriteCond %{THE_REQUEST} \s/+pages/records\.html[\s?] [NC]
RewriteRule ^pages/records\.html$ /document-management [R=302,L]
RewriteCond %{THE_REQUEST} \s/+pages/records-retention\.html[\s?] [NC]
RewriteRule ^pages/records-retention\.html$ /records-retention [R=302,L]
RewriteCond %{THE_REQUEST} \s/+pages/fam-administration-maintenance\.html[\s?] [NC]
RewriteRule ^pages/fam-administration-maintenance\.html$ /fam-administration [R=302,L]
RewriteCond %{THE_REQUEST} \s/+pages/under-maintenance\.html[\s?] [NC]
RewriteRule ^pages/under-maintenance\.html$ /under-maintenance [R=302,L]
RewriteCond %{THE_REQUEST} \s/+pages/settings\.html[\s?] [NC]
RewriteRule ^pages/settings\.html$ /fam-administration [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?pages/employee/dashboard\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)pages/employee/dashboard\.html$ [NC]
RewriteRule ^pages/employee/dashboard\.html$ %1employee/ [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?pages/employee/tasks\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)pages/employee/tasks\.html$ [NC]
RewriteRule ^pages/employee/tasks\.html$ %1employee/tasks [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?pages/employee/facility-requests\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)pages/employee/facility-requests\.html$ [NC]
RewriteRule ^pages/employee/facility-requests\.html$ %1employee/facility-requests [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?pages/employee/room-reservations\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)pages/employee/room-reservations\.html$ [NC]
RewriteRule ^pages/employee/room-reservations\.html$ %1employee/reservations [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?pages/employee/requests\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)pages/employee/requests\.html$ [NC]
RewriteRule ^pages/employee/requests\.html$ %1employee/reservations [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?pages/employee/approvals\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)pages/employee/approvals\.html$ [NC]
RewriteRule ^pages/employee/approvals\.html$ %1employee/tasks [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?pages/employee/notifications\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)pages/employee/notifications\.html$ [NC]
RewriteRule ^pages/employee/notifications\.html$ %1employee/notifications [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?pages/employee/profile\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)pages/employee/profile\.html$ [NC]
RewriteRule ^pages/employee/profile\.html$ %1employee/profile [R=302,L]

# Public FAM routes. These are internal rewrites, so the browser URL stays clean.
RewriteRule ^$ pages/dashboard.html [L]
RewriteRule ^dashboard/?$ pages/dashboard.html [L]
RewriteRule ^facilities-reservation/?$ pages/room-reservations.html [L]
RewriteRule ^visitor-management/?$ pages/visitor-management.html [L]
RewriteCond %{REQUEST_URI} ^(.*/visitor-scanner)$ [NC]
RewriteRule ^visitor-scanner$ %1/ [R=302,L]
RewriteRule ^visitor-scanner/?$ pages/visitor-scanner.html [L]
RewriteRule ^visitor-scanner\.html$ pages/visitor-scanner.html [L]
RewriteRule ^contract-management/?$ pages/contract-management.html [L]
RewriteRule ^legal-management/?$ pages/legal-management.html [L]
RewriteRule ^document-management/?$ pages/records.html [L]
RewriteRule ^records-retention/?$ pages/records-retention.html [L]
RewriteRule ^fam-administration/?$ pages/fam-administration-maintenance.html [L]
RewriteRule ^under-maintenance/?$ pages/under-maintenance.html [L]
RewriteCond %{REQUEST_URI} ^(.*/employee)$ [NC]
RewriteRule ^employee$ %1/ [R=302,L]
RewriteRule ^employee/?$ pages/employee/dashboard.html [L]
RewriteRule ^employee/tasks/?$ pages/employee/tasks.html [L]
RewriteRule ^employee/facility-requests/?$ pages/employee/facility-requests.html [L]
RewriteRule ^employee/reservations/?$ pages/employee/room-reservations.html [L]
RewriteRule ^employee/notifications/?$ pages/employee/notifications.html [L]
RewriteRule ^employee/profile/?$ pages/employee/profile.html [L]

ErrorDocument 404 /errors/404.html
